DB_DB=tenants
DB_USER=postgres
DB_PASSWORD=password
DB_PORT=5432
DB_PORT_INTERNAL=5432
# DB_HOST=db
DB_HOST=localhost


MIGRATION_DIR=/migrations
MIGRATION_HOST=db

PG_DSN="host=${DB_HOST} port=${DB_PORT_INTERNAL} dbname=${DB_DB} user=${DB_USER} password=${DB_PASSWORD} sslmode=disable"
MIGRATION_DSN="host=${MIGRATION_HOST} port=${DB_PORT_INTERNAL} dbname=${DB_DB} user=${DB_USER} password=${DB_PASSWORD} sslmode=disable"

# HTTP_HOST=app
HTTP_HOST=localhost
HTTP_PORT=8080

LOGGER_LEVEL=debug
# LOGGER_LEVEL=info

# SWAGGER_HOST=app
SWAGGER_HOST=localhost
SWAGGER_PORT=8090

REFRESH_TOKEN_SECRET_KEY=golang-is-very-cool
REFRESH_TOKEN_EXP=30      #minutes
ACCESS_TOKEN_SECRET_KEY=golang-is-incredible
ACCESS_TOKEN_EXP=5        #minutes


MODERATOR_ENDPOINTS=GET:/floor-plan/:floor,POST:/floor-plan/:floor,GET:/floor-plan/polygons/:floor,POST:/floor-plan/polygons/:code,DELETE:/floor-plan/polygons/:code,GET:/premise/:code,GET:/premise/,PATCH:/premise/,POST:/premise/
CLIENT_ENDPOINTS=GET:/floor-plan/:floor,GET:/floor-plan/polygons/:floor
DIRECTOR_ENDPOINTS=