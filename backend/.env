DB_DB=tenants
DB_USER=postgres
DB_PASSWORD=password
DB_PORT=5432
DB_PORT_INTERNAL=5432
# DB_HOST=db
DB_HOST=localhost


MIGRATION_DIR=/migrations
MIGRATION_HOST=db

PG_DSN="host=${DB_HOST} port=${DB_PORT_INTERNAL} dbname=${DB_DB} user=${DB_USER} password=${DB_PASSWORD} sslmode=disable"
MIGRATION_DSN="host=${MIGRATION_HOST} port=${DB_PORT_INTERNAL} dbname=${DB_DB} user=${DB_USER} password=${DB_PASSWORD} sslmode=disable"

# HTTP_HOST=app
HTTP_HOST=localhost
HTTP_PORT=8080

LOGGER_LEVEL=debug
# LOGGER_LEVEL=info

# SWAGGER_HOST=app
SWAGGER_HOST=localhost
SWAGGER_PORT=8090

REFRESH_TOKEN_SECRET_KEY=golang-is-very-cool
REFRESH_TOKEN_EXP=10080      #minutes
ACCESS_TOKEN_SECRET_KEY=golang-is-incredible
ACCESS_TOKEN_EXP=5        #minutes


MODERATOR_ENDPOINTS=POST:/floor-plan/:floor,POST:/floor-plan/polygons/:code,DELETE:/floor-plan/polygons/:code,PATCH:/premise/,POST:/premise/,GET:/clients/,POST:/clients/,GET:/clients/profile,GET:/clients/:email,GET:/rental/,GET:/rental/:id,POST:/rental/,PATCH:/rental/:id,GET:/applications/,PATCH:/applications/:id/status,GET:/contracts/:contract_id,POST:/payments,PATCH:/payments/:id/pay,PATCH:/payments/mark-paid,GET:/payments/:id,GET:/payments,GET:/payments/client

CLIENT_ENDPOINTS=GET:/clients/profile,POST:/rental/,GET:/rental/:id,GET:/payments/client,GET:/contracts/:contract_id,DELETE:/contracts/:contract_id,POST:/contracts/:contract_id/sign,PATCH:/payments/mark-paid

DIRECTOR_ENDPOINTS=POST:/floor-plan/:floor,POST:/floor-plan/polygons/:code,DELETE:/floor-plan/polygons/:code,PATCH:/premise/,POST:/premise/,GET:/clients/,POST:/clients/,GET:/clients/profile,GET:/clients/:email,GET:/rental/,GET:/rental/:id,POST:/rental/,PATCH:/rental/:id,GET:/contracts/:contract_id,GET:/payments/:id,GET:/payments,GET:/payments/client
